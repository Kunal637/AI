{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with credits, plan, and role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "admin"] },
        "credits": { "type": "number" },
        "planName": { "type": "string" },
        "planExpiry": { "type": "string" },
        "totalScans": { "type": "number" },
        "createdAt": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "photoURL": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "credits"]
    },
    "ScanReport": {
      "title": "ScanReport",
      "description": "AI detection and plagiarism scan reports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "plagiarismScore": { "type": "number" },
        "aiScore": { "type": "number" },
        "wordCount": { "type": "number" },
        "date": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "title", "fileName", "type", "status"]
    },
    "ActivationCode": {
      "title": "ActivationCode",
      "description": "Voucher activation codes for redeeming credits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "credits": { "type": "number" },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "credits", "maxUses", "isActive"]
    },
    "CreditTransaction": {
      "title": "CreditTransaction",
      "description": "Credit adjustment audit trail log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "type": { "type": "string" },
        "note": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "amount", "balanceAfter", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles keyed by auth UID"
    },
    "/reports/{reportId}": {
      "schema": "ScanReport",
      "description": "Collection of scan reports generated by users"
    },
    "/activation_codes/{codeId}": {
      "schema": "ActivationCode",
      "description": "Collection of promo and activation credit codes"
    },
    "/transactions/{txnId}": {
      "schema": "CreditTransaction",
      "description": "Credit ledger and transaction history"
    }
  }
}
